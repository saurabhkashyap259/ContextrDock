# Database
DATABASE_URL=postgresql://contextdock:password@localhost:5432/contextdock
POSTGRES_USER=contextdock
POSTGRES_PASSWORD=password
POSTGRES_DB=contextdock

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM Provider API Keys (BYOK - Bring Your Own Keys)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_BASE_URL=http://localhost:11434

# Security
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
FERNET_KEY=change-this-to-a-fernet-key-use-cryptography.fernet.Fernet.generate_key()

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Slack Bot (optional)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Connector OAuth Credentials (optional, for write-back actions)
# Configure these when adding connectors via API
